# PMate AI Server environment template
# Copy this file to .env for local setup and replace placeholders as needed.
# Never commit real credentials or production runtime values.

# Runtime-only; not referenced by origin/main code.
AI_CORS_ORIGINS=your-comma-separated-cors-origins

# Runtime-only; not referenced by origin/main code.
AI_MAX_CONCURRENT_REQUESTS=your-positive-integer

# Runtime-only; not referenced by origin/main code.
AI_MAX_TOTAL_UPLOAD_MB=your-positive-integer

# Runtime-only; not referenced by origin/main code.
AI_REQUIRE_OPENAI_API_KEY=your-boolean

# Runtime-only; not referenced by origin/main code.
PYTHONUNBUFFERED=your-0-or-1

# Referenced by origin/main code.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PDF_DETAIL=auto
ORG_CHART_FONT_PATH=/path/to/korean-font.ttf
PLANNING_ANALYSIS_RETRY_COUNT=0
PLANNING_ANALYSIS_TIMEOUT_SECONDS=300
PLANNING_MAX_ANALYSIS_CHUNKS=10
PLANNING_READJUST_MAX_ANALYSIS_CHUNKS=4
