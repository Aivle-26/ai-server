[Unit]
Description=AIPM AI API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/aipm/ai-server
EnvironmentFile=/etc/aipm/ai-server.env
ExecStart=/opt/aipm/ai-server/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8090 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
